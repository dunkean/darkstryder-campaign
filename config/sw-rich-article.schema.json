{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SW D6 simple article",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "subtype": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "document",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "title",
          "type",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "subtype",
    "tags",
    "warnings",
    "sections"
  ],
  "additionalProperties": false
}
