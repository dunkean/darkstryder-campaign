{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SW D6 rich reference entity",
  "type": "object",
  "required": ["schema_version", "id", "name", "kind", "universe", "aliases", "claims", "relations", "conflicts", "notes", "profiles", "links", "evidence", "source_documents", "editorial_overlays", "reference_document_id", "review_status", "generation"],
  "properties": {
    "schema_version": {"const": "sw-rich-entity/1"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "kind": {"type": "string"},
    "classification": {"type": "object", "description": "Reversible text-mining type with source-version evidence; not a model probability."},
    "universe": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "reference_document_id": {"type": "string"},
    "reference_ranking": {"type": "object"},
    "review_status": {"const": "unreviewed"},
    "live_campaign_state_inferred": {"const": false},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "notes": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "profiles": {"type": "array", "items": {"type": "object", "required": ["id", "data", "scope", "source_documents"], "properties": {"id": {"type": "string"}, "scope": {"type": "object"}, "source_documents": {"type": "array", "items": {"type": "string"}}}}},
    "links": {"type": "array", "items": {"type": "object", "required": ["target_id", "kind", "derivation"], "properties": {"target_id": {"type": "string"}, "kind": {"type": "string"}, "derivation": {"const": "text_mining"}}}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "source_documents": {"type": "array", "items": {"type": "object", "required": ["id", "version_id", "source_id", "body_sha256", "paragraph_votes"]}},
    "editorial_overlays": {"type": "array", "items": {"type": "object", "required": ["record_id", "revision", "content"]}},
    "generation": {"type": "object", "required": ["writer", "signature", "input_snapshot_hash", "originals_modified"], "properties": {"originals_modified": {"const": false}}}
  },
  "$defs": {
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "annotation": {
      "type": "object", "required": ["id", "text", "evidence_ids", "review_status", "sections", "source_scopes"],
      "properties": {"id": {"type": "string"}, "text": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}, "review_status": {"const": "unreviewed"}, "sections": {"type": "array", "items": {"type": "string"}}, "source_scopes": {"type": "array", "items": {"type": "object"}}}
    },
    "claim": {
      "allOf": [{"$ref": "#/$defs/annotation"}], "required": ["kind", "fields"],
      "properties": {"kind": {"enum": ["fact", "rule", "description", "gm_material"]}, "fields": {"type": "object"}}
    },
    "relation": {
      "allOf": [{"$ref": "#/$defs/annotation"}], "required": ["subject_id", "target_id", "predicate"],
      "properties": {"subject_id": {"type": "string"}, "target_id": {"type": "string"}, "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}}
    },
    "evidence": {
      "type": "object", "required": ["id", "paragraph_id", "source_id", "record_id", "version_id", "unit", "locator", "offset_start", "offset_end", "excerpt", "excerpt_sha256", "document_body_sha256", "version_sha256", "section", "scope", "selection"],
      "properties": {
        "id": {"type": "string"}, "paragraph_id": {"type": "string"}, "source_id": {"type": "string"}, "record_id": {"type": "string"}, "version_id": {"type": "string"},
        "unit": {}, "locator": {"type": "object"}, "offset_start": {"type": "integer", "minimum": 0}, "offset_end": {"type": "integer", "minimum": 0},
        "excerpt": {"type": "string"}, "excerpt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "version_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "markdown_sha256": {"type": ["string", "null"]}, "scope": {"type": "object"}, "section": {"type": "string"}, "selection": {"enum": ["reference", "add", "add_uncertain"]}
      }
    }
  }
}
