---
const views=[['overview','Accueil'],['ship','FarStar'],['crew','Équipage'],['hierarchy','Hiérarchie'],['npc','PNJ'],['faction','Factions'],['adventure','Scénario'],['event','Événements'],['planet','Planètes'],['map','Carte'],['library','Sources'],['skills','Compétences'],['relations','Groupes & liens'],['droids','Droïdes'],['random','Instantané']];
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>DarkStryder — Base de campagne</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="stylesheet" href="/styles/legacy.css"/><link rel="stylesheet" href="/styles/app.css"/><link rel="stylesheet" href="/styles/deck-plans.css"/><link rel="stylesheet" href="/styles/stellar-map.css"/></head>
<body>
<header><a class="brand" href="#overview">DARKSTRYDER <span class="sub">BASE DE CAMPAGNE</span></a><label>Heure <input id="hour" type="time" value="09:00"/></label><label><input id="alert" type="checkbox"/> Alerte</label><label>Quart <select id="mode"><option value="shift1">Quart 1</option><option value="shift2">Quart 2</option><option value="alert">Alerte</option></select></label><button id="schedule">Horaires</button><span id="saveStatus" role="status">Chargement…</span></header>
<aside><div class="search-wrap"><input id="globalSearch" placeholder="Tout rechercher…" aria-label="Recherche globale"/><div id="searchResults"></div></div><nav id="nav">{views.map(([id,label])=><button data-view={id} class={id==='overview'?'active':''}>{label}</button>)}</nav><button id="newEntity" class="primary">+ Nouvelle fiche</button></aside>
<main>{views.map(([id])=><section id={id} class={id==='overview'?'view active':'view'}></section>)}</main>
<div id="modal" class="modal" role="dialog" aria-modal="true" aria-label="Fiche"><div class="modalbox"><button class="close" onclick="closeModal()">Fermer</button><div id="modalContent"></div></div></div>
<script is:inline type="module" src="/modules/app.js"></script>
</body></html>
